@startuml

actor "HR Advisor"
actor "Department Manager"

rectangle Database

rectangle "HR System" {
    usecase UC1 as "Get salaries of all employees"
    usecase UC2 as "Get salaries by department"
    usecase UC3 as "Get salaries in my department"
    usecase UC4 as "Get salaries by role"
    usecase UC5 as "Add new employee's details"
    usecase UC6 as "View an employee's details"
    usecase UC7 as "Update an employee's details"
    usecase UC8 as "Delete an employee's details"
    usecase UCa as "Print salaries"
    UC4 ..> UCa : include
}

"HR Advisor" --> UC1
"HR Advisor" --> UC2
"HR Advisor" --> UC3
"HR Advisor" --> UC4
"HR Advisor" --> UC5
"HR Advisor" --> UC6
"HR Advisor" --> UC7
"HR Advisor" --> UC8
"Department Manager" --> UC3
UC1 --> Database
UC2 --> Database
UC3 --> Database
UC4 - Database
UC5 --> Database
UC6 --> Database
UC7 --> Database
UC8 --> Database

@enduml